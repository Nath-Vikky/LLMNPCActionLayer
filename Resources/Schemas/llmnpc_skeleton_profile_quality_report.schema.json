{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "llmnpc.skeleton_profile_quality_report.v1",
  "title": "LLM NPC Skeleton Profile Quality Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profileId",
    "skeletonPath",
    "skeletonSignature",
    "mappedBoneCount",
    "coreBoneCoverage",
    "fingerBoneCoverage",
    "fingerPoseCoverage",
    "axisCalibrationCoverage",
    "iKChainCount",
    "bSignatureCurrent",
    "bPassed",
    "errors",
    "warnings"
  ],
  "properties": {
    "profileId": { "type": "string", "minLength": 1 },
    "skeletonPath": { "type": "string", "minLength": 1 },
    "skeletonSignature": { "type": "string", "pattern": "^md5:[0-9a-fA-F]{32}$" },
    "mappedBoneCount": { "type": "integer", "minimum": 0 },
    "coreBoneCoverage": { "type": "number", "minimum": 0, "maximum": 1 },
    "fingerBoneCoverage": { "type": "number", "minimum": 0, "maximum": 1 },
    "fingerPoseCoverage": { "type": "number", "minimum": 0, "maximum": 1 },
    "axisCalibrationCoverage": { "type": "number", "minimum": 0, "maximum": 1 },
    "iKChainCount": { "type": "integer", "minimum": 0 },
    "bSignatureCurrent": { "type": "boolean" },
    "bPassed": { "type": "boolean" },
    "errors": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
