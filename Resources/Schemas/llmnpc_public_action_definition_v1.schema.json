{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llmnpc.local/schemas/llmnpc_public_action_definition_v1.schema.json",
  "title": "LLM NPC Public Action Definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "public_action_id",
    "semantic_version",
    "definition_revision",
    "display_name",
    "selection_summary",
    "suitable_when",
    "avoid_when",
    "semantic_effect_tags",
    "target_category_tags",
    "gesture_family",
    "default_style",
    "search_keywords",
    "requires_target",
    "content_hash"
  ],
  "properties": {
    "schema_version": { "const": "llmnpc.public_action_definition.v1" },
    "public_action_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "semantic_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "definition_revision": { "type": "integer", "minimum": 1 },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "selection_summary": { "type": "string", "minLength": 1, "maxLength": 240 },
    "suitable_when": { "$ref": "#/$defs/context_list" },
    "avoid_when": { "$ref": "#/$defs/context_list" },
    "semantic_effect_tags": { "$ref": "#/$defs/tag_list_nonempty" },
    "target_category_tags": { "$ref": "#/$defs/tag_list" },
    "gesture_family": { "type": "string", "minLength": 1, "maxLength": 64 },
    "default_style": { "type": "string", "minLength": 1, "maxLength": 64 },
    "incompatible_action_families": { "$ref": "#/$defs/tag_list" },
    "search_keywords": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 80 }
    },
    "requires_target": { "type": "boolean" },
    "content_hash": { "type": "string", "pattern": "^md5:[0-9a-f]{32}$" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "requires_target": { "const": true } },
        "required": ["requires_target"]
      },
      "then": {
        "properties": { "target_category_tags": { "minItems": 1 } }
      },
      "else": {
        "properties": { "target_category_tags": { "maxItems": 0 } }
      }
    }
  ],
  "$defs": {
    "tag_list": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 64 }
    },
    "tag_list_nonempty": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 64 }
    },
    "context_list": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 160 }
    }
  }
}
